# Copy to .env (gitignored). Local dev values only.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:54329/avc
DATABASE_URL_API=postgresql://app_api:app_api_dev@localhost:54329/avc
DATABASE_URL_WORKER=postgresql://app_worker:app_worker_dev@localhost:54329/avc
DATABASE_URL_RELAY=postgresql://app_relay:app_relay_dev@localhost:54329/avc
APP_API_PASSWORD=app_api_dev
APP_WORKER_PASSWORD=app_worker_dev
APP_RELAY_PASSWORD=app_relay_dev
# true: this API process runs the canned proposal (UI demo and tests). A live clean needs false,
# plus `docker compose --profile media up` and `uv run python -m app.pipeline.mac_agent`.
FAKE_WORKER=true
REDIS_URL=redis://localhost:63799/0
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_BUCKET=avc-local
JWT_SECRET=local-dev-only-secret-change-me-0123456789
JWT_TTL_SECONDS=1800
FRONTEND_BASE_URL=http://localhost:3000
OPENAI_API_KEY=
GEMMA_BASE_URL=
GEMMA_API_KEY=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
